<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.smateso</groupId>
        <artifactId>spring-boot-parent</artifactId>
        <version>1.0.1</version>
    </parent>

    <groupId>com.smateso.proof</groupId>
    <artifactId>proof-data-service</artifactId>
    <version>1.0.0</version>
    <name>PROOF Data Service</name>
    <description>PROOF Data Service</description>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <java.version>21</java.version>
        <git.host>gitlab.kit.edu/</git.host>
        <git.user.id>kit/iai/webis/proof2</git.user.id>
        <git.repo.id>proof-data-service</git.repo.id>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.10.1</version>
                <configuration>
                    <excludes>
                        <exclude>generated/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>3.2.3</version>
                <configuration>
                    <mainClass>com.smateso.proof.App</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <configuration>
                            <profiles>test</profiles>
                        </configuration>
                        <goals>
                            <goal>start</goal>
                            <goal>stop</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-maven-plugin</artifactId>
                <version>1.4</version>
                <executions>
                    <execution>
                        <id>integration-test</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <apiDocsUrl>http://localhost:8080/v3/api-docs</apiDocsUrl>
                            <outputFileName>api.json</outputFileName>
                            <outputDir>${project.build.directory}</outputDir>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>7.2.0</version>
                <executions>
                    <execution>
                        <id>gen-typescript</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <verbose>false</verbose>
                            <cleanupOutput>true</cleanupOutput>
                            <enablePostProcessFile>true</enablePostProcessFile>
                            <inputSpec>${project.build.directory}/api.json</inputSpec>
                            <output>${project.basedir}/generated/client</output>
                            <generatorName>typescript-axios</generatorName>
                            <gitHost>${gitHost}</gitHost>
                            <gitUserId>${gitUserId}</gitUserId>
                            <gitRepoId>${gitRepoId}</gitRepoId>
                            <additionalProperties>
                                <additionalProperty>apiPackage=api</additionalProperty>
                                <additionalProperty>modelPackage=model</additionalProperty>
                                <additionalProperty>withSeparateModelsAndApi=true</additionalProperty>
                                <additionalProperty>supportsES6=true</additionalProperty>
                                <additionalProperty>withInterfaces=true</additionalProperty>
                                <additionalProperty>npmVersion=${project.version}</additionalProperty>
                                <additionalProperty>npmName=@proof/data-service-client</additionalProperty>
                            </additionalProperties>
                        </configuration>
                    </execution>
                    <execution>
                        <id>gen-java</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <verbose>false</verbose>
                            <cleanupOutput>true</cleanupOutput>
                            <enablePostProcessFile>true</enablePostProcessFile>
                            <inputSpec>${project.build.directory}/api.json</inputSpec>
                            <output>${project.basedir}/generated/server</output>
                            <library>webclient</library>
                            <generatorName>java</generatorName>
                            <gitHost>${gitHost}</gitHost>
                            <gitUserId>${gitUserId}</gitUserId>
                            <gitRepoId>${gitRepoId}</gitRepoId>
                            <gitHost>gitlab.lubw.de</gitHost>
                            <gitUserId>smateso</gitUserId>
                            <gitRepoId>fis-hwrm/hwrm-measure-status-service</gitRepoId>
                            <artifactId>proof-data-service-client</artifactId>
                            <groupId>com.smateso.proof</groupId>
                            <artifactVersion>${project.version}</artifactVersion>
                            <apiPackage>api</apiPackage>
                            <modelPackage>model</modelPackage>
                            <additionalProperties>
                                <additionalProperty>annotationLibrary=swagger2</additionalProperty>
                                <additionalProperty>serializationLibrary=gson</additionalProperty>
                            </additionalProperties>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
                <version>3.4.1</version>
                <configuration>
                    <from>
                        <image>azul/zulu-openjdk-alpine:21.0.2-jre@sha256:89b5c9245c76e25d98983480d09c08299d3876756921c4047f088af5e3fcc951</image>
                        <platforms>
                            <platform>
                                <architecture>amd64</architecture>
                                <os>linux</os>
                            </platform>
                            <platform>
                                <architecture>arm64</architecture>
                                <os>linux</os>
                            </platform>
                        </platforms>
                    </from>
                    <to>
                        <image>{artifactId}:${project.version}</image>
                    </to>
                    <container>
                        <mainClass>com.smateso.proof.App</mainClass>
                    </container>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
